# Copy this file to .env and fill in local values. Never commit .env.

# Ollama daemon endpoint (default local install)
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3.2:latest

# MLflow tracking
MLFLOW_TRACKING_URI=file:./outputs/mlruns

# ChromaDB persistence directory
CHROMA_PERSIST_DIR=./outputs/chroma_db

# Logging
LOG_LEVEL=INFO
